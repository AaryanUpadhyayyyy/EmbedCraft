PORT=4000
MONGO_URI=mongodb://localhost:27017/nudge_db

# Redis (Local / AWS ElastiCache / Redis Cloud / Upstash)
# Option 1: Full URL (highest priority — simplest for cloud providers)
# REDIS_URL=rediss://default:password@host:port
# Option 2: Host + Port + Password (ElastiCache, manual setup)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Cache TTLs (seconds) — override to tune per environment
# CACHE_TTL_NUDGE=300
# CACHE_TTL_ORG=600
# CACHE_TTL_USER=120
# CACHE_TTL_SEGMENT=300

# AWS S3 (Asset Storage - replaces Cloudinary)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
CLOUDFRONT_URL=

# AWS SQS (Event Queue - high-scale event ingestion)
AWS_SQS_QUEUE_URL=

# SQS Worker Tuning (only needed for standalone worker process)
# WORKER_BATCH_SIZE=100
# WORKER_FLUSH_INTERVAL_MS=5000

# Gmail SMTP for Support Form (use App Password, not regular password)
GMAIL_USER=contactembedcraft@gmail.com
GMAIL_APP_PASSWORD=
